# 공개 로컬 기본값. 개인 비밀값·override는 이 모듈의 .env에 작성한다.
# 우선순위: process env > .env > .env.local > 코드 기본값.

# 범용 Provider; openai | vllm | llama_cpp | bedrock. 기본 openai; model과 호환되는 값만 허용.
# 변경 후 해당 프로세스를 재시작한다.
AI_GENERAL_PROVIDER=openai

# 범용 모델; 아래 Provider별 enum 허용값만 지정. 기본 gpt-5.6-luna.
# openai: gpt-5.6-luna
# bedrock: global.openai.gpt-5.6-luna
# vllm: Qwen/Qwen3.8-27B-FP8 | Qwen/Qwen3-14B-AWQ | Qwen/Qwen3-32B-AWQ | unsloth/Qwen3.8-27B-unsloth-bnb-4bit
# llama_cpp: unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_M
# 신규 업무 실행 반영은 model 명령으로 capability별 DB 버전을 명시 적용한다. F2 release와 별개.
# 변경 후 해당 프로세스를 재시작한다.
AI_GENERAL_MODEL=gpt-5.6-luna
