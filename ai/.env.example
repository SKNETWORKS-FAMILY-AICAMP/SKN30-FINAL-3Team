# ai/.env로 복사하고 권한 600을 사용한다. API/Worker는 infra/local/run.py가 이 모듈 값을 주입한다.
# Provider/model override는 .env.local의 enum 주석을 참고하여 두 값을 함께 변경한다.

# 선택한 범용 Provider 인증 키(비밀 문자열). 기본 없음; OpenAI 사용 시, vllm/llama_cpp URL 설정 시 필수. Bedrock에서는 입력 금지.
# 변경 후 해당 프로세스를 재시작한다.
AI_GENERAL_API_KEY=

# 범용 API 주소; http/https URL, userinfo/query/fragment 금지. OpenAI 기본 https://api.openai.com/v1; vllm/llama_cpp는 키와 함께 지정. Bedrock 입력 금지.
# 변경 후 해당 프로세스를 재시작한다.
# AI_GENERAL_BASE_URL=

# Bedrock AWS region; AWS region 형식 문자열. 기본 없음; bedrock일 때만 필수, AWS role 인증 사용.
# 변경 후 해당 프로세스를 재시작한다.
# AI_GENERAL_AWS_REGION=ap-northeast-2

# AI 호출 제한(초); 유한 실수 >0. 기본 60; 모든 AI 호출에 적용.
# 변경 후 해당 프로세스를 재시작한다.
# AI_REQUEST_TIMEOUT_SECONDS=60

# F2 SLLM API 주소; http/https URL. 기본 미설정; STT URL과 함께 설정, 둘 다 없으면 F2 미구성(503).
# 변경 후 해당 프로세스를 재시작한다.
# AI_VLLM_SLLM_BASE_URL=http://127.0.0.1:8001/v1

# F2 STT API 주소; http/https URL. 기본 미설정; SLLM URL과 함께 설정. 주소 설정은 실제 정상 기동을 보장하지 않음.
# 변경 후 해당 프로세스를 재시작한다.
# AI_VLLM_STT_BASE_URL=http://127.0.0.1:8002/v1

# F2 SLLM 인증 키(비밀 문자열). 기본 없음; 인증 서버 사용 시 URL과 함께 지정.
# 변경 후 해당 프로세스를 재시작한다.
# AI_VLLM_SLLM_API_KEY=

# F2 STT 인증 키(비밀 문자열). 기본 없음; 인증 서버 사용 시 URL과 함께 지정.
# 변경 후 해당 프로세스를 재시작한다.
# AI_VLLM_STT_API_KEY=

# F2 서버 모델 alias; enum 허용 sllm만. 기본 sllm; 파인튜닝 버전은 Infra release로 구분.
# 변경 후 해당 프로세스를 재시작한다.
# AI_F2_SLLM_MODEL=sllm

# F2 STT 서버 모델 alias; enum 허용 stt만. 기본 stt; 서버 공개명과 일치해야 함.
# 변경 후 해당 프로세스를 재시작한다.
# AI_F2_STT_MODEL=stt

# F2 전사 언어; enum 허용 ko만. 기본 ko; 새 언어 지원 시 코드·평가를 함께 추가.
# 변경 후 해당 프로세스를 재시작한다.
# AI_F2_STT_LANGUAGE=ko

# 선택적 embedding API 주소; http/https URL. 기본 미설정; embedding 기능에서만 사용, STT 주소 재사용 금지.
# 변경 후 해당 프로세스를 재시작한다.
# AI_VLLM_EMBEDDING_BASE_URL=

# embedding 인증 키(비밀 문자열). 기본 없음; embedding URL 설정 시만 사용.
# 변경 후 해당 프로세스를 재시작한다.
# AI_VLLM_EMBEDDING_API_KEY=
