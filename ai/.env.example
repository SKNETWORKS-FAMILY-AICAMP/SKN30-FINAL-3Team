# Copy this file to .env and fill only the private values needed locally.
# Public team defaults are versioned in .env.local. Never commit .env.
AI_OPENAI_API_KEY=

AI_VLLM_SLLM_API_KEY=
AI_VLLM_STT_API_KEY=

AI_VLLM_SLLM_BASE_URL=
AI_VLLM_STT_BASE_URL=

# F3 를 로컬 vLLM 으로 돌릴 때만 채운다. 절차는 infra/runpod/f3-vllm-runbook.md 를 본다.
# AI_VLLM_SLLM_BASE_URL 과 동시에 설정할 수 없다.
AI_VLLM_F3_API_KEY=
AI_VLLM_F3_BASE_URL=

# 로컬 vLLM 은 OpenAI 보다 느리다. 32B 기준 중개 판정 한 번이 40~70초 걸리므로
# .env.local 의 기본값 60 을 그대로 쓰면 판정 단계가 타임아웃 경계에 걸린다.
AI_REQUEST_TIMEOUT_SECONDS=
