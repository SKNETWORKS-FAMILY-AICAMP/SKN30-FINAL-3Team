# 공개 로컬 기본값. 개인 비밀값·override는 이 모듈의 .env에 작성한다.
# 우선순위: process env > .env > .env.local > 코드 기본값.

# 실행 환경; 허용 local | test | dev | prod. 기본 local; local만 파일을 읽고 local/test만 OpenAPI를 공개한다.
# 변경 후 해당 프로세스를 재시작한다.
APP_ENV=local

# HTTP listen 주소; IP/hostname. 기본 127.0.0.1; API 실행 시 사용.
# 변경 후 해당 프로세스를 재시작한다.
APP_HOST=127.0.0.1

# HTTP listen 포트; 정수 1~65535. 기본 8000; API 실행 시 사용.
# 변경 후 해당 프로세스를 재시작한다.
APP_PORT=8000

# DB 용도; 허용 development | test | production. 기본 없음; APP_ENV local/dev=development, test=test, prod=production 필수.
# 변경 후 해당 프로세스를 재시작한다.
DB_TARGET=development

# 합성 개발 계정 로그인 공개; true | false. 코드 기본 false, local 기본 true; prod 금지.
# 변경 후 해당 프로세스를 재시작한다.
AUTH_DEVELOPMENT_ENABLED=true

# 개발 로그인 사무소 ID; 양의 정수. 기본 없음; 개발 로그인 사용 시 필수.
# 변경 후 해당 프로세스를 재시작한다.
AUTH_DEVELOPMENT_BROKERAGE_ID=1

# 개발 로그인 계정; 비어 있지 않은 문자열. 기본 없음; 개발 로그인 사용 시 필수.
# 변경 후 해당 프로세스를 재시작한다.
AUTH_DEVELOPMENT_LOGIN_ID=developer

# 로그 수준; DEBUG | INFO | WARNING | ERROR | CRITICAL. 기본 INFO; 대소문자를 정확히 지정.
# 변경 후 해당 프로세스를 재시작한다.
LOG_LEVEL=INFO

# 로그 형식; console | json. 기본 console; 공유 배포는 json.
# 변경 후 해당 프로세스를 재시작한다.
LOG_FORMAT=console

# 합성 데이터 사용 허용; true | false. 기본 false; Worker 실행 전 합성 데이터만 사용함을 확인하고 true 지정.
# 변경 후 해당 프로세스를 재시작한다.
F3_ALLOW_SYNTHETIC_PROTOTYPE=true

# 합성 챗봇 실행 허용; true | false. 기본 false; 모델 DB 반영과 Provider 연결 필요, prod 금지.
# 변경 후 해당 프로세스를 재시작한다.
CHATBOT_ENABLED=true
