APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_OPENAPI_ENABLED=true

DB_TARGET=development
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30

AUTH_DEVELOPMENT_ENABLED=true
AUTH_DEVELOPMENT_BROKERAGE_ID= 1
AUTH_DEVELOPMENT_LOGIN_ID=developer
AUTH_SESSION_COOKIE_NAME=brokerage_session
AUTH_CSRF_COOKIE_NAME=brokerage_csrf
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=1440
AUTH_SESSION_ABSOLUTE_TIMEOUT_MINUTES=10080
AUTH_SESSION_LAST_SEEN_UPDATE_SECONDS=300
AUTH_SESSION_COOKIE_DOMAIN=

HTTP_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
HTTP_ALLOWED_HOSTS=["localhost","127.0.0.1"]

LOG_LEVEL=INFO
LOG_FORMAT=console

WORKER_ENABLED=false
WORKER_READY_FILE=/tmp/brokerage-worker-ready
WORKER_ID=

AI_REQUEST_TIMEOUT_SECONDS=60
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_LLM_ENDPOINTS=[]
AI_F2_PROVIDER_STATUS=active
AI_VLLM_SLLM_BASE_URL=http://127.0.0.1:8001/v1
AI_VLLM_EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
AI_VLLM_STT_BASE_URL=http://127.0.0.1:8002/v1
