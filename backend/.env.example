# backend/.env로 복사하고 권한 600을 사용한다. AI 입력은 ai/.env에만 작성한다.

# API/Worker DB 접속 URL(비밀); postgresql+psycopg URL. 기본 없음; 필수.
# 변경 후 해당 프로세스를 재시작한다.
DB_URL=

# migration 전용 DB URL(비밀); postgresql+psycopg URL. 기본 없음; migration 시 필수.
# 변경 후 해당 프로세스를 재시작한다.
DB_MIGRATION_URL=

# 통합 테스트 전용 DB URL(비밀); PostgreSQL URL. 기본 없음; 통합 테스트 시 필수, 개발/운영 DB 금지.
# 변경 후 해당 프로세스를 재시작한다.
TEST_DB_URL=

# 프로세스 DB pool 크기; 정수 >=1. 기본 5; 연결 수 조정 시만 지정.
# 변경 후 해당 프로세스를 재시작한다.
# DB_POOL_SIZE=5

# 프로세스 추가 DB 연결 상한; 정수 >=0. 기본 5; 연결 수 조정 시만 지정.
# 변경 후 해당 프로세스를 재시작한다.
# DB_POOL_MAX_OVERFLOW=5

# DB pool 대기 제한(초); 정수 >=1. 기본 30; 운영 조정 시만 지정.
# 변경 후 해당 프로세스를 재시작한다.
# DB_POOL_TIMEOUT_SECONDS=30

# 세션 유휴 만료(분); 정수 >=1. 기본 1440; 세션 정책 조정 시 지정.
# 변경 후 해당 프로세스를 재시작한다.
# AUTH_SESSION_IDLE_TIMEOUT_MINUTES=1440

# 세션 절대 만료(분); 정수 >=1. 기본 10080; 세션 정책 조정 시 지정.
# 변경 후 해당 프로세스를 재시작한다.
# AUTH_SESSION_ABSOLUTE_TIMEOUT_MINUTES=10080

# 세션 사용 시각 DB 갱신 간격(초); 정수 >=1. 기본 300; 쓰기 부하 조정 시 지정.
# 변경 후 해당 프로세스를 재시작한다.
# AUTH_SESSION_LAST_SEEN_UPDATE_SECONDS=300

# 세션 cookie domain; hostname 또는 빈 값. 기본 빈 값(host-only); 도메인 공유가 필요할 때만 지정.
# 변경 후 해당 프로세스를 재시작한다.
# AUTH_SESSION_COOKIE_DOMAIN=

# CORS 허용 origin; JSON 문자열 배열. 기본 localhost:5173; 인증 CORS에서 * 금지.
# 변경 후 해당 프로세스를 재시작한다.
# HTTP_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# HTTP 허용 host; JSON 문자열 배열. 기본 localhost,127.0.0.1; 외부 접근 host 추가 시 지정.
# 변경 후 해당 프로세스를 재시작한다.
# HTTP_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# F2 음성 요청 상한(bytes); 정수 >=1. 기본 26214400(25 MiB); API 용량 조정 시 지정.
# 변경 후 해당 프로세스를 재시작한다.
# F2_MAX_AUDIO_BYTES=26214400

# 챗봇 요청 전체 제한(초); 정수 1~60. 기본 60; 챗봇 사용 시 적용.
# 변경 후 해당 프로세스를 재시작한다.
# CHATBOT_REQUEST_TIMEOUT_SECONDS=60

# 공개 기본값 변경은 .env.local의 필요한 변수만 .env에 추가한다.

# 로컬 자동 판정 접수 설정. 합성 데이터 사용 허용·모델 설정을 확인한 후 활성화한다.
# 기본값·허용 범위·재시작 대상은 .env.local을 참고한다.
# F3_AUTO_JUDGMENT_ENABLED=true
# F3_AUTO_DEBOUNCE_SECONDS=3
# F3_AUTO_BATCH_SIZE=20
