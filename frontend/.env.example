# frontend 환경 변수 예시
#
# Vite의 VITE_ 변수는 번들에 그대로 포함된다. 비밀값을 넣지 않는다.
# 실제 값은 .env.local에 둔다.

# 장부 데이터 출처: mock | api
# 백엔드 F1 원장 엔드포인트가 준비되기 전에는 mock으로 화면을 완성한다.
VITE_LEDGER_SOURCE=mock

# API 기본 경로. 개발에서는 Vite proxy를 거치도록 같은 오리진 경로를 쓴다.
VITE_API_BASE_URL=/api/v1

# Vite dev server가 /api 요청을 넘길 백엔드 주소. backend/.env.local의 APP_PORT와 맞춘다.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# mock 전용 값. VITE_LEDGER_SOURCE=api면 무시된다.
VITE_MOCK_ROW_COUNT=7200
VITE_MOCK_LATENCY_MS=350
