# Frontend 공개 입력. VITE_*에 비밀값 금지; 개인 override는 .env에 작성한다.

# 개발 로그인 UI; true | false. local 기본 true; Backend 개발 인증 허용과 맞춘다.
# 변경 후 개발 서버 재시작 또는 재빌드 필요.
# VITE_AUTH_DEVELOPMENT_ENABLED=true

# 장부 출처; enum mock | api. 기본 mock; F3/calendar 빈 값의 상속 기준.
# 변경 후 개발 서버 재시작 또는 재빌드 필요.
# VITE_LEDGER_SOURCE=mock

# F3 출처; enum mock | api 또는 빈 값. 기본 빈 값(장부 출처 상속); Worker 미실행 시 mock 선택.
# 변경 후 개발 서버 재시작 또는 재빌드 필요.
# VITE_F3_SOURCE=

# 캘린더 출처; enum mock | api 또는 빈 값. 기본 빈 값(장부 출처 상속).
# 변경 후 개발 서버 재시작 또는 재빌드 필요.
# VITE_CALENDAR_SOURCE=

# 동일 origin API 경로; /api 하위 경로. 기본 /api/v1; 외부 URL·query·fragment 금지.
# 변경 후 개발 서버 재시작 또는 재빌드 필요.
# VITE_API_BASE_URL=/api/v1

# mock 생성 행 수; 안전한 정수 >=0. 기본 7200; mock 모드에서만 사용.
# 변경 후 개발 서버 재시작 또는 재빌드 필요.
# VITE_MOCK_ROW_COUNT=7200

# mock 응답 지연(ms); 안전한 정수 >=0. 기본 350; mock 모드에서만 사용.
# 변경 후 개발 서버 재시작 또는 재빌드 필요.
# VITE_MOCK_LATENCY_MS=350

# 개발 proxy origin; http/https origin. 기본 http://127.0.0.1:8000; API path 제외, 브라우저 번들 제외.
# 변경 후 개발 서버 재시작 또는 재빌드 필요.
# FRONTEND_BACKEND_ORIGIN=http://127.0.0.1:8000
