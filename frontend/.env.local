# 팀 공통 로컬 공개 설정. 비밀값을 넣지 않는다.
VITE_AUTH_DEVELOPMENT_ENABLED=true
VITE_LEDGER_SOURCE=mock

# F3 교차 판정 출처. 지정하지 않으면 VITE_LEDGER_SOURCE를 따른다.
# Backend가 살아 있어도 WORKER_ENABLED=false이면 실행이 QUEUED에 머물러 완료 화면을 볼 수 없다.
# 그때는 개인 .env에서 아래를 켜 장부는 api, F3만 mock으로 둔다.
# VITE_F3_SOURCE=mock

# 캘린더 일정 출처. 지정하지 않으면 VITE_LEDGER_SOURCE를 따른다.
# VITE_CALENDAR_SOURCE=mock
VITE_API_BASE_URL=/api/v1
VITE_MOCK_ROW_COUNT=7200
VITE_MOCK_LATENCY_MS=350

# Vite dev proxy에서만 사용하며 VITE_ prefix가 없어 브라우저 번들에 포함되지 않는다.
FRONTEND_BACKEND_ORIGIN=http://127.0.0.1:8000
