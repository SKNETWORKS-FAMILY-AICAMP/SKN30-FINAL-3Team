{
  "name": "prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file=.env.local --env-file-if-exists=.env ./node_modules/vite/bin/vite.js",
    "build": "node --env-file=.env.local --env-file-if-exists=.env ./node_modules/vite/bin/vite.js build",
    "preview": "node --env-file=.env.local --env-file-if-exists=.env ./node_modules/vite/bin/vite.js preview",
    "test:ledger": "node --test tests/ledger-mappers.test.ts tests/ledger-fixtures.test.ts",
    "test:auth": "node --test tests/auth-session.test.ts tests/auth-screen.test.mjs",
    "test:f2": "node --test tests/f2-consultation-routing.test.ts",
    "test:f3": "node --test tests/f3-decode.test.ts tests/f3-mock.test.ts tests/f3-candidate-label.test.ts tests/f3-feedback-error.test.ts",
    "test:browser": "node --test tests/f3-panel.browser.test.mjs",
    "test:env": "node --test tests/env-cli.test.mjs tests/env-schema.test.ts tests/vite-config.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:release": "node --env-file=.env.local --env-file-if-exists=.env --test tests/release-build.test.mjs"
  },
  "dependencies": {
    "@patternfly/react-core": "^6.6.1",
    "@patternfly/react-icons": "^6.6.1",
    "@vitejs/plugin-react": "5.0.4",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.61.1",
    "typescript": "^5.9.2"
  }
}
