.env
.env.*
!.env.example
!backend/.env.local
!backend/.env.prod
*.pem
*.key
*.cert

# ==========================================
# Operating System & IDEs (OS 및 IDE 설정 파일)
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDEs
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# AI Agent Workspaces / IDE Brain
.gemini/
.brain/

# ==========================================
# Frontend - Node.js / React / Vite (`frontend/`)
# ==========================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
frontend/.nyc_output/
frontend/artifacts/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Python - (`ai/`, `backend/`, `data/`)
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
.venv*/

# Build & Distribution
build/
dist/
*.egg-info/
.eggs/
*.egg

# Testing & Linting
.pytest_cache/
.hypothesis/
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.coverage
htmlcov/
.coverage.*
coverage.xml
coverage.json
*.cover

# Local migration tool state/config (may contain database credentials)
.yoyo-migrate

# Jupyter Notebooks
.ipynb_checkpoints

# ==========================================
# Infrastructure - Terraform / AWS (`infra/`)
# ==========================================
# Local .terraform directory
.terraform/
infra/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variables file (contains sensitive values)
*.tfvars
*.tfvars.json
!example.tfvars
!*.example.tfvars

# Terraform overrides & crash logs
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log

# ==========================================
# General Logs & Temporary Files
# ==========================================
*.log
*.sqlite
*.sqlite3
*.db
tmp/
temp/
