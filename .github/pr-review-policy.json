{
  "version": 2,
  "limits": {
    "maxFiles": 200,
    "maxChangedLines": 10000,
    "maxContextChars": 200000,
    "headFileMaxChars": 20000,
    "headFileMaxBytes": 80000,
    "headEvidenceMaxChars": 60000,
    "headEvidenceMaxFiles": 20,
    "chunkChangedLines": 2000,
    "chunkPatchChars": 80000,
    "maxChunks": 10,
    "maxConcurrency": 3,
    "chunkMaxFindings": 3,
    "maxMergeContextChars": 300000,
    "maxFindings": 5,
    "leafMaxOutputTokens": 2500,
    "mergeMaxOutputTokens": 4000
  },
  "cost": {
    "currency": "USD",
    "updated": "2026-09-04",
    "serviceTier": "default",
    "longContextThresholdTokens": 272000,
    "models": {
      "gpt-5.6-luna": {
        "inputPerMillion": 0.2,
        "cachedInputPerMillion": 0.02,
        "cacheWritePerMillion": 0.25,
        "outputPerMillion": 1.2,
        "longContextInputMultiplier": 2,
        "longContextOutputMultiplier": 1.5
      },
      "gpt-5.6-terra": {
        "inputPerMillion": 2,
        "cachedInputPerMillion": 0.2,
        "cacheWritePerMillion": 2.5,
        "outputPerMillion": 12,
        "longContextInputMultiplier": 2,
        "longContextOutputMultiplier": 1.5
      }
    }
  },
  "ignored": {
    "basenames": [
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "bun.lock",
      "bun.lockb",
      "uv.lock",
      "requirements.lock",
      "poetry.lock",
      "Pipfile.lock",
      "Cargo.lock",
      ".terraform.lock.hcl"
    ],
    "prefixes": [
      ".terraform/",
      "coverage/",
      "frontend/build/",
      "frontend/dist/"
    ],
    "suffixes": [
      ".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico",
      ".pdf",
      ".doc", ".docx",
      ".xls", ".xlsx",
      ".ppt", ".pptx",
      ".odt", ".ods", ".odp",
      ".hwp", ".hwpx",
      ".zip", ".gz",
      ".woff", ".woff2", ".ttf"
    ]
  },
  "headFileEvidence": {
    "files": [
      ".gitignore",
      ".gitattributes",
      "AGENTS.md",
      "CLAUDE.md",
      ".github/pr-review-policy.json"
    ],
    "includePolicyDocuments": true,
    "suffixes": [],
    "excludedBasenamePrefixes": [
      ".env"
    ],
    "excludedBasenameFragments": [
      ".tfvars"
    ],
    "excludedSuffixes": [
      ".pem",
      ".key",
      ".p12",
      ".pfx",
      ".pkcs8",
      ".pkcs12",
      ".jks",
      ".der",
      ".crt",
      ".cer"
    ]
  },
  "always": {
    "files": [
      "AGENTS.md",
      ".agents-rule/git.md",
      ".agents/skills/project-wiki/SKILL.md",
      ".agents/skills/project-wiki/references/index.md",
      ".agents/skills/project-wiki/references/decisions/index.md"
    ]
  },
  "arbiter": {
    "minChunks": 2,
    "minModules": 2
  },
  "projectWide": {
    "prefixes": [
      ".github/",
      ".agents-rule/",
      ".agents/skills/",
      ".gitignore",
      ".gitattributes",
      "AGENTS.md",
      "CLAUDE.md"
    ],
    "files": []
  },
  "modules": {
    "frontend": {
      "prefixes": ["frontend/", "docs/screen/"],
      "policyPrefixes": [".agents/skills/frontend/"],
      "files": [
        ".agents/skills/frontend/SKILL.md",
        ".agents/skills/frontend/references/index.md",
        ".agents/skills/frontend/references/decisions/index.md"
      ]
    },
    "backend": {
      "prefixes": ["backend/", "docs/db/"],
      "policyPrefixes": [".agents/skills/backend/"],
      "files": [
        ".agents/skills/backend/SKILL.md",
        ".agents/skills/backend/references/index.md",
        ".agents/skills/backend/references/architecture.md",
        ".agents/skills/backend/references/testing-and-quality.md",
        ".agents/skills/backend/references/open-questions.md",
        ".agents/skills/backend/references/decisions/index.md"
      ]
    },
    "ai": {
      "prefixes": ["ai/", "docs/architecture/f2/", "docs/architecture/f3/"],
      "policyPrefixes": [".agents/skills/ai/"],
      "files": [
        ".agents/skills/ai/SKILL.md",
        ".agents/skills/ai/references/index.md",
        ".agents/skills/ai/references/open-questions.md",
        ".agents/skills/ai/references/decisions/index.md"
      ]
    },
    "data": {
      "prefixes": ["data/"],
      "policyPrefixes": [".agents/skills/data/"],
      "files": [
        ".agents/skills/data/SKILL.md",
        ".agents/skills/data/references/index.md",
        ".agents/skills/data/references/dataset-design.md",
        ".agents/skills/data/references/evaluation-design.md",
        ".agents/skills/data/references/open-questions.md",
        ".agents/skills/data/references/decisions/index.md"
      ]
    },
    "infra": {
      "prefixes": ["infra/", "docs/architecture/infra/"],
      "policyPrefixes": [".agents/skills/infra/"],
      "files": [
        ".agents/skills/infra/SKILL.md",
        ".agents/skills/infra/references/index.md",
        ".agents/skills/infra/references/resource-inventory.md",
        ".agents/skills/infra/references/terraform-standards.md",
        ".agents/skills/infra/references/open-questions.md",
        ".agents/skills/infra/references/decisions/index.md",
        ".agents/skills/project-wiki/references/decisions/ADR-0007-terraform-iac.md"
      ]
    }
  },
  "policyPacks": [
    {
      "id": "ci-workflow-governance",
      "phases": ["leaf", "arbiter"],
      "requiresArbiter": true,
      "when": [{ "prefixes": [".github/workflows/"] }],
      "files": [
        ".agents/skills/project-wiki/references/development/environments.md",
        {
          "path": ".agents/skills/project-wiki/references/privacy/policy.md",
          "sections": ["원칙", "구현 규칙", "변경 검토"]
        }
      ]
    },
    {
      "id": "review-agent-governance",
      "phases": ["leaf", "arbiter"],
      "requiresArbiter": true,
      "when": [
        { "prefixes": [".github/scripts/pr-", ".github/workflows/pr-policy-review.yml"] },
        { "files": [".github/pr-review-policy.json"] },
        { "prefixes": [".agents/skills/project-wiki/references/decisions/ADR-0010-", ".agents/skills/project-wiki/references/decisions/ADR-0016-", ".agents/skills/project-wiki/references/decisions/ADR-0024-"] }
      ],
      "files": [
        ".agents/skills/project-wiki/references/decisions/ADR-0010-pr-policy-ai-review-discord.md",
        ".agents/skills/project-wiki/references/decisions/ADR-0016-pr-review-cross-chunk-evidence.md",
        ".agents/skills/project-wiki/references/decisions/ADR-0024-pr-review-policy-routing-and-arbitration.md",
        {
          "path": ".agents/skills/project-wiki/references/privacy/policy.md",
          "sections": ["원칙", "PR Policy Agent 외부 전송", "변경 검토"]
        }
      ]
    },
    {
      "id": "module-boundaries",
      "phases": ["leaf", "arbiter"],
      "when": [
        { "modulesAny": ["backend", "ai"] },
        { "minModules": 2 },
        { "prefixes": [".agents/skills/project-wiki/references/architecture/"] }
      ],
      "files": [
        ".agents/skills/project-wiki/references/architecture/overview.md",
        ".agents/skills/project-wiki/references/architecture/runtime.md",
        ".agents/skills/project-wiki/references/decisions/ADR-0006-ai-backend-boundary.md"
      ]
    },
    {
      "id": "api-contract-base",
      "phases": ["leaf", "arbiter"],
      "requiresArbiter": true,
      "when": [
        { "prefixes": ["backend/src/api/", "frontend/src/shared/api/"] },
        { "contains": ["/api/"] },
        { "files": [".agents/skills/project-wiki/references/contracts/api.md"] }
